# Copy to .env. Default "offline" needs no keys.
LLM_PROVIDER=offline          # offline | openai | azure | anthropic | bedrock
EMBEDDING_PROVIDER=offline    # offline | openai | azure | bedrock

# --- OpenAI
# OPENAI_API_KEY=sk-...

# --- Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Anthropic (LLM only; pair with openai/azure/bedrock embeddings)
# ANTHROPIC_API_KEY=sk-ant-...

# --- AWS Bedrock (uses your normal AWS credentials / profile)
# AWS_REGION=us-east-1

# Changing EMBEDDING_PROVIDER changes the vector space: delete data/chroma and re-ingest.
MIN_RELEVANCE=0.15
